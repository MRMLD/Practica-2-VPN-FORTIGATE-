! Infra 3 - R-CLIENTE (Cisco IOL L3): VLAN 10, DHCP, NAT y VPN (DES)
enable
configure terminal
hostname R-CLIENTE
no ip domain-lookup
interface Ethernet0/0
 description HACIA-ISP
 ip address 200.6.82.2 255.255.255.252
 ip nat outside
 no shutdown
interface Ethernet0/1
 description TRONCAL-USUARIOS
 no ip address
 no shutdown
interface Ethernet0/1.10
 description VLAN10-USUARIOS
 encapsulation dot1Q 10
 ip address 10.6.82.1 255.255.255.128
 ip nat inside
ip route 0.0.0.0 0.0.0.0 200.6.82.1
ip dhcp excluded-address 10.6.82.1 10.6.82.9
ip dhcp pool USUARIOS-VLAN10
 network 10.6.82.0 255.255.255.128
 default-router 10.6.82.1
 dns-server 8.8.8.8 1.1.1.1
 lease 1
ip access-list extended NAT-USUARIOS
 deny ip 10.6.82.0 0.0.0.127 10.6.82.128 0.0.0.15
 permit ip 10.6.82.0 0.0.0.127 any
ip nat inside source list NAT-USUARIOS interface Ethernet0/0 overload
crypto isakmp policy 10
 encryption des
 authentication pre-share
 group 2
 lifetime 86400
crypto isakmp key Clave0682 address 200.6.82.6
crypto ipsec transform-set TS-0682 esp-des esp-sha-hmac
 mode tunnel
ip access-list extended VPN-TRAFICO
 permit ip 10.6.82.0 0.0.0.127 10.6.82.128 0.0.0.15
crypto map CM-0682 10 ipsec-isakmp
 set peer 200.6.82.6
 set transform-set TS-0682
 match address VPN-TRAFICO
interface Ethernet0/0
 crypto map CM-0682
end
write memory
